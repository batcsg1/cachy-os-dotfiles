{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo-rgb.txt",
    "padding": { "top": 1, "right": 4 },
    "color": {
        "1": "38;2;255;23;68",
        "2": "38;2;255;109;0",
        "3": "38;2;255;214;0",
        "4": "38;2;0;230;118",
        "5": "38;2;0;229;255",
        "6": "38;2;41;121;255",
        "7": "38;2;213;0;249"
      }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "38;2;0;229;255",
            "title": "1;38;2;255;0;170",
            "output": "38;2;230;230;240",
            "separator": "38;2;106;100;136"
        },
        "percent": { "type": 9 },
        "bar": { "charElapsed": "█", "charTotal": "░", "borderLeft": "[", "borderRight": "]" }
    },
    "modules": [
        {
            "type": "title",
            "color": { "user": "1;38;2;255;0;170", "at": "38;2;106;100;136", "host": "1;38;2;0;229;255" }
        },
        { "type": "separator", "string": "━", "outputColor": "38;2;213;0;249" },
        { "type": "os",       "key": " ", "keyColor": "38;2;255;23;68",  "format": "{3} (Btw)" },
        { "type": "kernel",   "key": " ", "keyColor": "38;2;255;109;0" },
        { "type": "wm",       "key": " ", "keyColor": "38;2;255;214;0" },
        { "type": "shell",    "key": " ", "keyColor": "38;2;0;230;118" },
        { "type": "terminal", "key": " ", "keyColor": "38;2;0;229;255" },
        { "type": "uptime",   "key": " ", "keyColor": "38;2;41;121;255" },
        { "type": "separator", "string": "━", "outputColor": "38;2;0;229;255" },
        { "type": "host",     "key": "󰇅 ", "keyColor": "38;2;255;23;68" },
        { "type": "cpu",      "key": " ", "keyColor": "38;2;255;109;0" },
        { "type": "gpu",      "key": "󰢮 ", "keyColor": "38;2;255;214;0" },
        { "type": "memory",   "key": " ", "keyColor": "38;2;0;230;118" },
        { "type": "disk",     "key": "󰋊 ({mountpoint})", "keyColor": "38;2;41;121;255", "folders": "/:/home:/mnt/backups" },
        "break",
        { "type": "colors", "symbol": "block" }
    ]
}
