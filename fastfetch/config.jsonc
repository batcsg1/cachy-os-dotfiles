{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "cachyos",
        "padding": {
            "top": 1,
            "right": 4
        },
        "color": {
            "1": "38;2;136;192;208",
            "2": "38;2;143;188;187",
            "3": "38;2;94;129;172",
            "4": "38;2;129;161;193"
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "38;2;136;192;208",
            "title": "1;38;2;136;192;208",
            "output": "38;2;216;222;233",
            "separator": "38;2;76;86;106"
        },
        "percent": {
            "type": 9
        },
        "bar": {
            "char": {
                "elapsed": "█",
                "total": "░"
            },
            "border": {
                "left": "[",
                "right": "]"
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "1;38;2;136;192;208",
                "at": "38;2;76;86;106",
                "host": "1;38;2;129;161;193"
            }
        },
        {
            "type": "separator",
            "string": "━",
            "outputColor": "38;2;76;86;106"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "38;2;94;129;172",
            "format": "{3} (Btw)"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "38;2;129;161;193"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "38;2;136;192;208"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "38;2;143;188;187"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "38;2;163;190;140"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "38;2;235;203;139"
        },
        {
            "type": "separator",
            "string": "━",
            "outputColor": "38;2;76;86;106"
        },
        {
            "type": "host",
            "key": "󰇅 ",
            "keyColor": "38;2;94;129;172"
        },
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "38;2;129;161;193"
        },
        {
            "type": "gpu",
            "key": "󰢮 ",
            "keyColor": "38;2;136;192;208"
        },
        {
            "type": "memory",
            "key": "󰍛 ",
            "keyColor": "38;2;143;188;187"
        },
        {
            "type": "disk",
            "key": "󰋊 ({mountpoint})",
            "keyColor": "38;2;163;190;140",
            "folders": "/:/home:/mnt/backups"
        },
        "break",
        {
            "type": "colors",
            "symbol": "block"
        }
    ]
}