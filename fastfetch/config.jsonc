{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "type": "file",
      "source": "~/.config/fastfetch/logo.txt",
      "color": {
          "1": "38;2;245;184;196"
      }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "38;2;151;197;233",
            "title": "38;2;238;144;168"
        }
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": " ",
      	    "format": "{3} (Btw)"
        },
        {
            "type": "host",
            "key": "󰇅"
        },
        {
          "type": "wm",
          "key": " "
        },
        {
            "type": "uptime",
            "key": " "
        },
        {
            "type": "shell",
            "key": " "
        },
	{
	    "type": "terminal",
	    "key": " "
	},
        {
            "type": "cpu",
            "key": " "
        },
	{
	    "type": "gpu",
	    "key": "󰢮 "
	},
        {
            "type": "memory",
            "key": " "
        },
	{
            "type": "disk",
            "key": "󰋊 ({mountpoint})"
        },
    ]
}
